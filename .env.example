# === Application ===
GRPC_ADDR=:9090
GRPC_AUTH_TOKEN=change-me
MAX_UPLOAD_BYTES=524288000
MIME_ALLOWLIST=image/*,video/*,audio/*
WORKER_CONCURRENCY=2
QUEUE_BUFFER=64
FFMPEG_TIMEOUT=10m
SHUTDOWN_TIMEOUT=30s
RENDITION=720
THUMB_SECOND=1
PRESIGN_TTL=15m
TTL_REAP_INTERVAL=1m
RATE_LIMIT_RPS=50
MAX_CONCURRENT_STREAMS=8
MIGRATIONS_PATH=/app/migrations

# === Postgres ===
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=media
POSTGRES_USER=media
POSTGRES_PASSWORD=media
POSTGRES_DSN=postgres://media:media@postgres:5432/media?sslmode=disable
POSTGRES_CONNECT_TIMEOUT=5s
POSTGRES_QUERY_TIMEOUT=30s

# === MinIO ===
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=media
MINIO_USE_SSL=false

# === Kafka (optional) ===
KAFKA_ENABLED=false
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC=media.events
KAFKA_DLQ_TOPIC=media.events.dlq
KAFKA_GROUP=media-service
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_TLS=false
KAFKA_POLL_TIMEOUT=1s
KAFKA_RECONNECT_MAX_BACKOFF=10s
