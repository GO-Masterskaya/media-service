# === Application ===
GRPC_ADDR=:9090
GRPC_AUTH_TOKEN=change-me
MAX_UPLOAD_BYTES=524288000
MIME_ALLOWLIST=image/*,video/*,audio/*
WORKER_CONCURRENCY=2
QUEUE_BUFFER=64
JOB_TIMEOUT=12m
JOB_LEASE=30s
POLL_INTERVAL=1s
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_BASE=30s
JOB_BACKOFF_MAX=10m
JOB_BACKOFF_JITTER=0.2
# Max stale running jobs processed per reaper tick (SKIP LOCKED LIMIT).
JOB_REAP_BATCH_SIZE=100
FFMPEG_TIMEOUT=10m
SHUTDOWN_TIMEOUT=30s
RENDITION=720
THUMB_SECOND=1
PROCESSING_TEMP_DIR=/tmp/processing
PRESIGN_TTL=15m
TTL_REAP_INTERVAL=1m
TTL_REAP_BATCH_SIZE=100
TTL_REAP_DRY_RUN=false
RATE_LIMIT_RPS=50
MAX_CONCURRENT_STREAMS=8
MIGRATIONS_PATH=/app/migrations

# === Upload Temp Storage ===
UPLOAD_TEMP_DIR=/tmp/media-uploads
UPLOAD_RESERVE_BYTES=104857600
UPLOAD_STALE_GRACE=1h

# === Postgres ===
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=media
POSTGRES_USER=media
POSTGRES_PASSWORD=media
POSTGRES_DSN=postgres://media:media@postgres:5432/media?sslmode=disable
POSTGRES_CONNECT_TIMEOUT=5s
POSTGRES_QUERY_TIMEOUT=30s

# === MinIO ===
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=media
MINIO_USE_SSL=false

# === Kafka (optional) ===
KAFKA_ENABLED=false
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC=media.events
KAFKA_DLQ_TOPIC=media.events.dlq
KAFKA_GROUP=media-service

# Feature-flag: строгая проверка владельца.
# true  — требует валидного x-owner-id из доверенного gateway (deploy за посредником).
# false — ТЗ v1: доверяем вызывающему, owner-проверка только на уровне бизнес-логики.
STRICT_OWNER_CHECK=false

# Retention processed_events (#39).
# Окно OLDER_THAN обязано с запасом превышать retention Kafka-топика:
# если запись о done/dlq событии удалена раньше, чем истечёт retention
# Kafka, при передоставке этого события side-effect выполнится повторно.
# Дефолт 30d перекрывает стандартные 7d с запасом.
RETENTION_INTERVAL=1h
RETENTION_OLDER_THAN=720h
RETENTION_BATCH_SIZE=1000